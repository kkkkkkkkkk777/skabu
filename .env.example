# J-Quants ダッシュボード「設定 → APIキー」から発行する
# https://jpx-jquants.com/
JQUANTS_API_KEY=

# free / light / standard / premium
# 無料は12週間遅延・5リクエスト/分。Light は当日引け後・60リクエスト/分
JQUANTS_PLAN=free

JQUANTS_BASE_URL=https://api.jquants.com/v2

# DEBUG にするとリクエスト単位の詳細と失敗ダンプが増える
SKABU_LOG_LEVEL=INFO
SKABU_DATA_DIR=data
SKABU_LOG_DIR=logs
SKABU_HTTP_TIMEOUT_SEC=30
SKABU_HTTP_MAX_RETRIES=4
# serve の自動同期。0 で止める
SKABU_AUTO_SYNC=1

# カブコム（三菱UFJ eスマート証券）kabuステーション API
# false のあいだはペーパー。true のときだけ実発注
KABU_LIVE=false
KABU_API_PASSWORD=
KABU_BASE_URL=http://127.0.0.1:18080/kabusapi
KABU_MAX_ORDER_YEN=1000000
